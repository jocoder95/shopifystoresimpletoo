

{% assign background_image = collection.metafields.custom.background_image.value %}
{% assign theme_color = collection.metafields.custom.theme_color.value %}

<section
  class="universal-collection scroll-animate"
  style="
    {% if background_image != blank %}
      background-image:
        linear-gradient(
          rgba(255,255,255,0.55),
          rgba(255,255,255,0.55)
        ),
        url('{{ background_image | image_url: width: 2400 }}');
    {% endif %}
    {% if theme_color != blank %}
      color: {{ theme_color }};
    {% endif %}
  "
>

  <!-- Hero -->
  <div class="universal-collection__hero">

    {% if collection.image %}
      <div class="universal-collection__hero-image">
        {{
          collection.image
          | image_url: width: 2000
          | image_tag:
            loading: 'eager',
            widths: '750, 1100, 1500, 2000'
        }}
      </div>
    {% endif %}

    <div class="universal-collection__hero-content">

      <p class="universal-collection__eyebrow">
        COLLECTION
      </p>

      <h1 class="universal-collection__title">
        {{ collection.title }}
      </h1>

      {% if collection.description != blank %}
        <div class="universal-collection__description">
          {{ collection.description }}
        </div>
      {% endif %}

    </div>

  </div>

  <!-- Products -->
  <div class="universal-collection__products-wrapper">

    <div class="universal-collection__header">

      <h2>
        {{ collection.products_count }}
        Products
      </h2>

    </div>

    {% paginate collection.products by 24 %}

      <div class="universal-collection__grid">

        {% for product in collection.products %}

          <a
            href="{{ product.url }}"
            class="universal-collection__product"
          >

            <div class="universal-collection__product-image">

              {% if product.featured_image %}
                {{
                  product.featured_image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 500, 700, 900',
                    class: 'universal-collection__primary-image',
                    alt: product.title
                }}

                {% if product.images.size > 1 %}
                  {{
                    product.images[1]
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '300, 500, 700, 900',
                      class: 'universal-collection__secondary-image',
                      alt: product.title
                  }}
                {% endif %}

              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}

            </div>

            <div class="universal-collection__product-info">

              <h3>
                {{ product.title }}
              </h3>

              <p>
                {{ product.price | money }}
              </p>

              {% render 'product-available-sizes', product: product %}

            </div>

          </a>

        {% endfor %}

      </div>

      {% if paginate.pages > 1 %}

        <nav class="universal-collection__pagination">

          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}">
              ← Previous
            </a>
          {% endif %}

          <span>
            Page {{ paginate.current_page }}
            of {{ paginate.pages }}
          </span>

          {% if paginate.next %}
            <a href="{{ paginate.next.url }}">
              Next →
            </a>
          {% endif %}

        </nav>

      {% endif %}

    {% endpaginate %}

  </div>

</section>

{% schema %}
{
  "name": "Universal Collection",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    }
  ]
}
{% endschema %}
