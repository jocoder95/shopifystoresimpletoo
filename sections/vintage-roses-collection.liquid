{{ 'vintage-roses.css' | asset_url | stylesheet_tag }}

<section
  class="vintage-roses"
  {% if section.settings.background_image %}
    style="
      background-image:
        linear-gradient(
          rgba(255, 255, 255, 0.55),
          rgba(255, 255, 255, 0.55)
        ),
        url('{{ section.settings.background_image | image_url: width: 2400 }}');
    "
  {% endif %}
>

  <!-- Hero -->
  <div class="vintage-roses__hero">

    {% if collection.image %}
      <div class="vintage-roses__hero-image">
        {{
          collection.image
          | image_url: width: 2000
          | image_tag:
            loading: 'eager',
            widths: '750, 1100, 1500, 2000'
        }}
      </div>
    {% endif %}

    <div class="vintage-roses__hero-content">

      <p class="vintage-roses__eyebrow">
        COLLECTION
      </p>

      <h1 class="vintage-roses__title">
        {{ collection.title }}
      </h1>

      {% if collection.description != blank %}
        <div class="vintage-roses__description">
          {{ collection.description }}
        </div>
      {% endif %}

    </div>

  </div>


  <!-- Products -->
  <div class="vintage-roses__products-wrapper">

    <div class="vintage-roses__header">

      <h2>
        {{ collection.products_count }}
        Products
      </h2>

    </div>


    {% paginate collection.products by 24 %}

      <div class="vintage-roses__grid">

        {% for product in collection.products %}

          <a
            href="{{ product.url }}"
            class="vintage-roses__product"
          >

            <div class="vintage-roses__product-image">

              {% if product.featured_image %}

                {{
                  product.featured_image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 500, 700, 900',
                    alt: product.featured_image.alt
                    | default: product.title
                }}

              {% else %}

                {{ 'product-1' | placeholder_svg_tag }}

              {% endif %}

            </div>


            <div class="vintage-roses__product-info">

              <h3>
                {{ product.title }}
              </h3>

              <p>
                {{ product.price | money }}
              </p>

            </div>

          </a>

        {% endfor %}

      </div>


      {% if paginate.pages > 1 %}

        <nav class="vintage-roses__pagination">

          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}">
              ← Previous
            </a>
          {% endif %}

          <span>
            Page {{ paginate.current_page }}
            of {{ paginate.pages }}
          </span>

          {% if paginate.next %}
            <a href="{{ paginate.next.url }}">
              Next →
            </a>
          {% endif %}

        </nav>

      {% endif %}

    {% endpaginate %}

  </div>

</section>


{% schema %}
{
  "name": "Vintage Roses Collection",

  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    }
  ]
}
{% endschema %}