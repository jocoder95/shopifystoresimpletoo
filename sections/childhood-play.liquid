{% comment %}
  Static meadow scene with editable copy about the care behind the clothes.
  The decorative landscape stays separate from the accessible text.
  @example
  <!-- Add above the New this season product list in the homepage editor. -->
{% endcomment %}

{% if section.settings.background_color != blank %}
  {% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}
{% endif %}
<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>
<div class="section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}">
  <div
    class="childhood-play"
    style="--play-height: {{ section.settings.height }}px;"
  >
    <svg aria-hidden="true" class="childhood-play__meadow" viewBox="0 0 1200 100" width="1200" height="100" preserveAspectRatio="none" focusable="false">
      <path d="M0 39Q180 0 390 40T790 34T1200 32V100H0Z" fill="#E5EAD9" />
      <path d="M0 66Q260 25 520 64T1000 57T1200 60V100H0Z" fill="#D4DFC5" />
    </svg>
    {% for index in (1..7) %}
      <svg aria-hidden="true" class="childhood-play__flower" style="--play-flower-position: {{ index | times: 13 | minus: 3 }}%;" viewBox="0 0 30 48" width="30" height="48" focusable="false">
        <path d="M15 44V18m0 17q-13 0-11-10 10 0 11 10m0-6q12 0 11-10-10 1-11 10" fill="#9BAE87" stroke="#9BAE87" stroke-width="2" />
        <g fill="#FFF9EE">
          <ellipse cx="15" cy="10" rx="4" ry="8" /><ellipse cx="15" cy="22" rx="4" ry="8" />
          <ellipse cx="9" cy="16" rx="8" ry="4" /><ellipse cx="21" cy="16" rx="8" ry="4" />
        </g>
        <circle cx="15" cy="16" r="4" fill="#D9B46D" />
      </svg>
    {% endfor %}
    {% if section.settings.heading != blank or section.settings.text != blank %}
      <div class="childhood-play__copy">
        {% if section.settings.heading != blank %}
          <h2 class="childhood-play__heading h3">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.text != blank %}
          <div class="childhood-play__text rte">{{ section.settings.text }}</div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .childhood-play {
    position: relative;
    display: grid;
    place-items: center;
    min-inline-size: 0;
    min-block-size: var(--play-height);
    padding-block: calc(var(--padding-2xl) * 2) 100px;
    padding-inline: var(--padding-2xl);
    overflow: clip;
    container-type: inline-size;
  }

  .childhood-play__meadow {
    position: absolute;
    inset-inline-start: 0;
    inset-block-end: 0;
    inline-size: 100%;
    block-size: 84px;
    pointer-events: none;
  }

  .childhood-play__flower {
    position: absolute;
    inset-inline-start: var(--play-flower-position);
    inset-block-end: 16px;
    inline-size: clamp(16px, 2.5cqw, 28px);
    block-size: auto;
    pointer-events: none;
  }

  .childhood-play__flower:nth-of-type(even) {
    inset-block-end: 4px;
    rotate: -12deg;
  }

  .childhood-play__copy {
    position: relative;
    display: grid;
    gap: var(--gap-xl);
    inline-size: 100%;
    max-inline-size: var(--normal-content-width);
    min-inline-size: 0;
    text-align: center;
    overflow-wrap: anywhere;
  }

  .childhood-play__heading,
  .childhood-play__text > :first-child {
    margin-block-start: 0;
  }

  .childhood-play__heading,
  .childhood-play__text > :last-child {
    margin-block-end: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.text",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:settings.heading" },
    { "type": "richtext", "id": "text", "label": "t:settings.text" },
    { "type": "range", "id": "height", "label": "t:settings.height", "min": 180, "max": 420, "step": 20, "unit": "px", "default": 280 },
    { "type": "color", "id": "background_color", "label": "t:settings.background_color", "default": "#FAF7F0" },
    {
      "type": "select", "id": "section_width", "label": "t:settings.width",
      "options": [{ "value": "page-width", "label": "t:options.page" }, { "value": "full-width", "label": "t:options.full" }],
      "default": "full-width"
    }
  ],
  "presets": [{ "name": "t:names.text", "category": "t:categories.decorative" }]
}
{% endschema %}
