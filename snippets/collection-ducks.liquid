{% doc %}
  Three decorative ducklings that waddle beneath the Duck Pond link on hover
  or keyboard focus. Inline artwork stays independent of interface colors.
  @example
  <!-- Render inside a collection-links__link--ducks anchor. -->
  {% render 'collection-ducks' %}
{% enddoc %}

<span class="collection-ducks" aria-hidden="true">
  {% for index in (1..3) %}
    <span class="collection-ducks__walker" style="--duck-position: {{ index | times: 20 | minus: 10 }}%; --duck-delay: -{{ index | times: 0.65 }}s;">
      <svg class="collection-ducks__duckling" viewBox="0 0 44 36" width="44" height="36" aria-hidden="true" focusable="false">
        <g class="collection-ducks__feet" fill="none" stroke="#D58E37" stroke-width="2" stroke-linecap="round">
          <path class="collection-ducks__foot collection-ducks__foot--front" d="M26 28v5h5" />
          <path class="collection-ducks__foot collection-ducks__foot--back" d="M17 28v5h5" />
        </g>
        <g class="collection-ducks__body">
          <path d="M8 15 2 12l3 10c1 8 11 11 20 8 6-2 9-7 8-12Z" fill="#F5CF68" />
          <circle cx="30" cy="11" r="9" fill="#F8D980" />
          <path d="m37 11 7 3-7 3Z" fill="#E99C43" />
          <path d="M11 20c5-5 11-3 13 1-2 5-9 7-13-1Z" fill="#E8B94F" />
          <circle cx="33" cy="9" r="1.3" fill="#594A38" />
        </g>
      </svg>
    </span>
  {% endfor %}
</span>

{% stylesheet %}
  .collection-links__link--ducks {
    position: relative;
  }

  .collection-ducks {
    position: absolute;
    inset: 0;
    display: none;
    pointer-events: none;
  }

  .collection-links__link--ducks:focus-visible .collection-ducks {
    display: block;
  }

  @media (hover: hover) {
    .collection-links__link--ducks:hover .collection-ducks {
      display: block;
    }
  }

  .collection-ducks__walker {
    position: absolute;
    inset-block-start: calc(100% - 6px);
    inset-inline-start: var(--duck-position);
    inline-size: var(--font-size--2xl);
    animation: collection-duck-walk 3.6s var(--duck-delay) linear infinite;
  }

  .collection-ducks__duckling {
    display: block;
    inline-size: 100%;
    block-size: auto;
    overflow: visible;
  }

  .collection-ducks__body {
    transform-origin: 50% 80%;
    animation: collection-duck-waddle 320ms var(--duck-delay) ease-in-out infinite alternate;
  }

  .collection-ducks__foot {
    transform-box: fill-box;
    transform-origin: 50% 0;
    animation: collection-duck-step 320ms var(--duck-delay) ease-in-out infinite alternate;
  }

  .collection-ducks__foot--back {
    animation-direction: alternate-reverse;
  }

  @keyframes collection-duck-walk {
    0% { transform: translateX(calc(-16px * var(--duck-direction, 1))); opacity: 0; }
    15% { opacity: 1; }
    85% { opacity: 1; }
    100% { transform: translateX(calc(48px * var(--duck-direction, 1))); opacity: 0; }
  }

  @keyframes collection-duck-waddle {
    from { transform: translateY(-1px) rotate(-6deg); }
    to { transform: translateY(1px) rotate(6deg); }
  }

  @keyframes collection-duck-step {
    from { transform: rotate(-22deg); }
    to { transform: rotate(22deg); }
  }

  [dir='rtl'] .collection-ducks__duckling {
    transform: scaleX(-1);
  }

  [dir='rtl'] .collection-ducks__walker {
    --duck-direction: -1;
  }

  @media (prefers-reduced-motion: reduce) {
    .collection-links__link--ducks:is(:hover, :focus-visible) .collection-ducks {
      display: none;
    }

    .collection-ducks__walker,
    .collection-ducks__body,
    .collection-ducks__foot {
      animation: none;
    }
  }
{% endstylesheet %}
