{% doc %}
  Three decorative bunnies that run beneath the Bunnies link on hover or keyboard
  focus. Illustration colors are independent of the surrounding UI palette.
  @example
  <!-- Render inside a collection-links__link--bunnies anchor. -->
  {% render 'collection-bunnies' %}
{% enddoc %}

<span class="collection-bunnies" aria-hidden="true">
  {% for index in (1..3) %}
    <span class="collection-bunnies__runner" style="--bunny-position: {{ index | times: 20 | minus: 10 }}%; --bunny-delay: -{{ index | times: 0.6 }}s;">
      <svg class="collection-bunnies__bunny" viewBox="0 0 48 40" width="48" height="40" aria-hidden="true" focusable="false">
        <g class="collection-bunnies__stride" fill="#E4D4CC" stroke="#B59D92" stroke-width="1" stroke-linejoin="round">
          <path class="collection-bunnies__leg collection-bunnies__leg--back" d="M14 26 6 34q-2 4 4 3l11-7Z" />
          <path class="collection-bunnies__leg collection-bunnies__leg--front" d="m30 25 4 10q2 3 7 0l-7-12Z" />
        </g>
        <g class="collection-bunnies__body" fill="#F5E9E1" stroke="#B59D92" stroke-width="1">
          <circle cx="6" cy="24" r="4.5" />
          <ellipse cx="21" cy="25" rx="14" ry="9" />
          <ellipse class="collection-bunnies__ears" cx="31" cy="10" rx="3" ry="9" transform="rotate(-17 31 10)" />
          <ellipse class="collection-bunnies__ears" cx="37" cy="10" rx="3" ry="9" transform="rotate(12 37 10)" />
          <ellipse cx="31" cy="10" rx="1.3" ry="6" fill="#EABDC2" stroke="none" transform="rotate(-17 31 10)" />
          <ellipse cx="37" cy="10" rx="1.3" ry="6" fill="#EABDC2" stroke="none" transform="rotate(12 37 10)" />
          <ellipse cx="35" cy="21" rx="9" ry="7" />
          <circle cx="38" cy="19" r="1.2" fill="#655049" stroke="none" />
          <circle cx="43" cy="23" r="1.6" fill="#D99CA7" stroke="none" />
        </g>
      </svg>
    </span>
  {% endfor %}
</span>

{% stylesheet %}
  .collection-links__link--bunnies {
    position: relative;
  }

  .collection-bunnies {
    position: absolute;
    inset: 0;
    display: none;
    pointer-events: none;
  }

  .collection-links__link--bunnies:focus-visible .collection-bunnies {
    display: block;
  }

  @media (hover: hover) {
    .collection-links__link--bunnies:hover .collection-bunnies {
      display: block;
    }
  }

  .collection-bunnies__runner {
    position: absolute;
    inset-block-start: calc(100% - 6px);
    inset-inline-start: var(--bunny-position);
    inline-size: var(--font-size--2xl);
    animation: collection-bunny-run 2.8s var(--bunny-delay) linear infinite;
  }

  .collection-bunnies__bunny {
    display: block;
    inline-size: 100%;
    block-size: auto;
    overflow: visible;
    animation: collection-bunny-bound 520ms var(--bunny-delay) ease-in-out infinite;
  }

  .collection-bunnies__leg {
    transform-box: fill-box;
    transform-origin: 50% 0;
    animation: collection-bunny-stride 260ms var(--bunny-delay) ease-in-out infinite alternate;
  }

  .collection-bunnies__leg--back {
    animation-direction: alternate-reverse;
  }

  @keyframes collection-bunny-run {
    0% { transform: translateX(calc(-12px * var(--bunny-direction, 1))); opacity: 0; }
    12%, 88% { opacity: 1; }
    100% { transform: translateX(calc(42px * var(--bunny-direction, 1))); opacity: 0; }
  }

  @keyframes collection-bunny-bound {
    0%, 100% { transform: translateY(0) scale(1.08, 0.92); }
    45% { transform: translateY(-10px) scale(0.95, 1.05); }
    75% { transform: translateY(-3px) scale(1); }
  }

  @keyframes collection-bunny-stride {
    from { transform: rotate(-25deg); }
    to { transform: rotate(25deg); }
  }

  [dir='rtl'] .collection-bunnies__runner {
    --bunny-direction: -1;
  }

  [dir='rtl'] .collection-bunnies__bunny {
    scale: -1 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .collection-links__link--bunnies:is(:hover, :focus-visible) .collection-bunnies {
      display: none;
    }

    .collection-bunnies__runner,
    .collection-bunnies__bunny,
    .collection-bunnies__leg {
      animation: none;
    }
  }
{% endstylesheet %}
